# HimbeerePi - Einstellungen. Vorlage fuer /etc/himbeerepi/himbeerepi.env
# Rechte: root:himbeerepi, 640 (enthaelt den geheimen Schluessel!)
#     sudo install -m 640 -o root -g himbeerepi deploy/himbeerepi.env.example /etc/himbeerepi/himbeerepi.env
# install.sh legt die Datei an und fuellt SECRET_KEY automatisch.

# Pflicht: zufaelliger Wert, z.B.  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ordner fuer die hochgeladenen Dateien. Grundeinrichtung: auf der SD-Karte. Ausbau 1 (Speicher-
# Festplatte, deploy/setup.sh) kopiert die Dateien auf die Platte und haengt sie genau hier ein -
# der Pfad bleibt also immer gleich. install.sh passt den Dienst an, falls er geaendert wird.
HIMBEEREPI_DATA_DIR=/srv/himbeerepi

# Benutzer-Datenbank
HIMBEEREPI_DB=/var/lib/himbeerepi/users.db

# Ausbau 2 (Backup-Festplatte): dorthin sichert backup_db.sh zusaetzlich die Datenbank
# (von Hand: vorher  sudo install -d -o himbeerepi -g himbeerepi /srv/himbeerepi-backup/db_backups)
#HIMBEEREPI_BACKUP_MOUNT=/srv/himbeerepi-backup

# Optional: Stromkosten-Anzeige (EUR pro kWh) und Pauschale fuer externe Festplatten in Watt
# (0 ohne Platte; der Einrichtungsassistent setzt 7 je Platte)
#HIMBEEREPI_POWER_PRICE=0.35
#HIMBEEREPI_HDD_WATTS=0

# Setzt der Einrichtungsassistent (deploy/setup.sh): Zugangsart (internet|heimnetz) und Domain
#HIMBEEREPI_ACCESS=
#HIMBEEREPI_DOMAIN=
# Nur fuer Zugang ohne HTTPS (Heimnetz) oder lokale Tests - nie bei Zugang aus dem Internet
#HIMBEEREPI_INSECURE_COOKIE=1

# Optional: Push-Meldungen zum taeglichen Backup ueber ntfy (Topic wirkt wie ein Passwort)
#NTFY_TOPIC=
#NTFY_SERVER=https://ntfy.sh
