# RaspiCloud - Cronjobs. Vorlage fuer /etc/cron.d/raspicloud (install.sh kopiert sie).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Stromverbrauch schaetzen (jede Minute, fuer die Stromkosten-Anzeige)
* * * * *   raspicloud  set -a; . /etc/raspicloud/raspicloud.env; set +a; /opt/raspicloud/venv/bin/python3 /opt/raspicloud/app/track_energy.py >/dev/null 2>&1
# Taegliches Datenbank-Backup
10 3 * * *  raspicloud  /opt/raspicloud/scripts/backup_db.sh
# Dienst pruefen, bei zwei Fehlschlaegen in Folge neu starten
*/5 * * * * root        /opt/raspicloud/scripts/check_health.sh
