[Unit]
Description=HimbeerePi (Gunicorn/Flask)
After=network.target local-fs.target

[Service]
User=himbeerepi
Group=himbeerepi
# video: Zugriff auf vcgencmd (Spannung, Drosselung, Leistung)
SupplementaryGroups=video
EnvironmentFile=/etc/himbeerepi/himbeerepi.env
# Grosse Uploads im Datenordner zwischenspeichern (mit Speicher-Festplatte: auf der Platte, nicht in RAM/SD)
Environment=TMPDIR=/srv/himbeerepi/tmp_uploads
WorkingDirectory=/opt/himbeerepi/app
ExecStart=/opt/himbeerepi/venv/bin/gunicorn --workers 2 --threads 4 --worker-class gthread --timeout 1800 --bind 127.0.0.1:5000 app:app
Restart=always

# Absicherung: der Dienst darf nur in Datenbank- und Datenordner schreiben
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/himbeerepi /srv/himbeerepi

[Install]
WantedBy=multi-user.target
